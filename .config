# This is an empty file, please overwrite it after generating the .config file with the source code
# 目标架构配置 (MT7620 属于 ralink 里的 mt7620 目标)
CONFIG_target_ramips=y
CONFIG_TARGET_ramips_mt7620=y
CONFIG_TARGET_ramips_mt7620_Device_xiaomi_router_mini=y

# 固件格式勾选 (生成常见的 sysupgrade 和 factory 刷机包)
CONFIG_TARGET_IMAGES_GZIP=y

# 基础系统配置
CONFIG_PACKAGE_kmod-mt76=y
CONFIG_PACKAGE_hostapd-common=y
CONFIG_PACKAGE_wpad-basic-mbedtls=y
CONFIG_PACKAGE_dnsmasq_full_dnssec=y
CONFIG_PACKAGE_iptables=y
CONFIG_PACKAGE_ip-full=y

# LuCI 界面与基础中文支持
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# 针对 R1C 16M Flash / 64M RAM 的精简优化插件
# （剔除大体积插件，保留常用网络与工具）
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_DEFAULT_opkg=y
